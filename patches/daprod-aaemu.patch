+using AAEmu.Game.Core.Packets;
+using AAEmu.Game.Models.Game.Char;
+using NLog;
+
+namespace AAEmu.Game;
+
+/// <summary>DaProd: small gameplay switches driven by DaProdTweaks (Manastorm shop on the HUD button).</summary>
+public static class DaProdGameplay
+{
+    private static readonly Logger Logger = LogManager.GetCurrentClassLogger();
+
+    /// <summary>merchant_random_packs id of the Manastorm (Palos) shop.</summary>
+    public const uint ManastormPack = 7;
+
+    private static HashSet<uint> _dailyQuests;
+
+    /// <summary>
+    /// Quests of the daily schedule ("Daily Contracts"): the client says they complete by themselves, with no turn-in,
+    /// so the server must push them to the reward as soon as the objectives are met (rule "dailyAuto").
+    /// </summary>
+    public static bool IsAutoDaily(uint questId)
+    {
+        if (!DaProdTweaks.On("dailyAuto"))
+            return false;
+        _dailyQuests ??= [.. GameData.TodayQuestGameData.Instance.AllGroups.SelectMany(g => g.QuestContextIds)];
+        return _dailyQuests.Contains(questId);
+    }
+
+    private sealed record RerollStash(ulong ItemId, int Index, uint Before, uint After, DateTime At);
+    private static readonly Dictionary<uint, RerollStash> _rerolls = [];
+
+    /// <summary>Remembers the line a "Replace Effect" just overwrote, so the player can take the old one back.</summary>
+    public static void StashReroll(uint characterId, ulong itemId, int index, uint before, uint after)
+    {
+        lock (_rerolls)
+            _rerolls[characterId] = new RerollStash(itemId, index, before, after, DateTime.UtcNow);
+    }
+
+    /// <summary>Puts the previous effect line back (and gives back the change attempt). Returns the message for the player.</summary>
+    public static string UndoReroll(Character character)
+    {
+        RerollStash stash;
+        lock (_rerolls)
+        {
+            if (!_rerolls.TryGetValue(character.Id, out stash))
+                return "Non c'è nessuna sostituzione da annullare.";
+        }
+
+        if (DateTime.UtcNow - stash.At > TimeSpan.FromMinutes(30))
+            return "L'ultima sostituzione è di più di 30 minuti fa: non si può più annullare.";
+        if (character.Inventory.GetItemById(stash.ItemId) is not Models.Game.Items.EquipItem item)
+            return "L'oggetto non c'è più.";
+        var groups = item.RndAttrGroupIds;
+        if (groups == null || stash.Index >= groups.Length || groups[stash.Index] != stash.After)
+            return "L'oggetto è cambiato dopo la sostituzione: non posso annullare.";
+
+        groups[stash.Index] = stash.Before;
+        item.RndAttrGroupIds = groups;
+        if (item.EvolveChance < 5)
+            item.EvolveChance++;
+        item.IsDirty = true;
+        character.SendPacket(new Core.Packets.G2C.SCItemDetailUpdatedPacket(item));
+        if (item.SlotType == Models.Game.Items.SlotType.Equipment)
+            character.UpdateGearBonuses(null, null);
+        lock (_rerolls)
+            _rerolls.Remove(character.Id);
+        return "Effetto precedente rimesso.";
+    }
+
+    /// <summary>Pack opened by the HUD "random shop" button (no NPC): the Manastorm shop when enabled.</summary>
+    public static uint DirectRandomShopPack() => DaProdTweaks.On("manastormShop") ? ManastormPack : 0u;
+
+    /// <summary>
+    /// Pushes the Manastorm shop record to the client at login: the client enables the HUD random-shop button once it
+    /// holds a record for it, and only shows the window when the player opens the store.
+    /// </summary>
+    public static void OnEnterGame(Character character)
+    {
+        if (character == null || !DaProdTweaks.On("manastormShop"))
+            return;
+        try
+        {
+            RandomShopUiService.SendInfo(character, ManastormPack, ManastormPack);
+        }
+        catch (Exception ex)
+        {
+            Logger.Warn(ex, "DAPROD manastorm shop push failed for {0}", character.Name);
+        }
+    }
+}
