+    public static void DaProdRescueToSolzreed(uint characterId)
+    {
+        _ = Task.Run(async () =>
+        {
+            try
+            {
+                await Task.Delay(4000); // after the logout save
+                using var connection = MySQL.CreateConnection();
+                using var command = connection.CreateCommand();
+                command.CommandText = "UPDATE characters SET zone_id=179, x=15578, y=15382, z=126 WHERE id=@id";
+                command.Parameters.AddWithValue("@id", characterId);
+                var rows = command.ExecuteNonQuery();
+                Logger.Warn("DAPROD rescue: character {0} moved to Solzreed ({1} row)", characterId, rows);
+            }
+            catch (Exception ex)
+            {
+                Logger.Error(ex, "DAPROD rescue of character {0} failed", characterId);
+            }
+        });
+    }
