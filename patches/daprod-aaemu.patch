+using AAEmu.Game.Core.Managers;
+using AAEmu.Game.Core.Managers.World;
+using AAEmu.Game.Models.Tasks;
+
+namespace AAEmu.Game;
+
+/// <summary>
+/// DaProd: a moment after a daily contract or an Arche Pass mission finishes, the character's whole daily/pass state is sent again,
+/// exactly as at login, so the open windows redraw by themselves instead of waiting for the player to close and reopen them.
+/// </summary>
+public sealed class DaProdTodayRefreshTask(uint characterId) : AAEmu.Game.Models.Tasks.Task
+{
+    public override void Execute()
+    {
+        var character = WorldManager.Instance.GetCharacterById(characterId);
+        if (character == null)
+            return;
+        TodayAssignmentManager.Instance.DaProdRefresh(character);
+    }
+
+    /// <summary>Queues one refresh (a burst of completions collapses into the same moment).</summary>
+    public static void Queue(uint characterId)
+    {
+        TaskManager.Instance.Schedule(new DaProdTodayRefreshTask(characterId), TimeSpan.FromMilliseconds(900));
+    }
+}
