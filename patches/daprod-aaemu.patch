+    /// <summary>DaProd: retries the zone handoff every second until the destination zone is loaded.</summary>
+    private async Task WaitForZoneHandoffAsync(AAEmu.Game.Core.Network.Connections.GameConnection connection, uint wantedZoneKey)
+    {
+        if (Interlocked.Exchange(ref _zoneHandoffWaiting, 1) == 1)
+            return; // already waiting (the refusal repeats on every position update)
+        try
+        {
+            Logger.Warn("Zone {0} not loaded yet: {1} waits for it", wantedZoneKey, Name);
+            for (var i = 0; i < 100; i++)
+            {
+                await Task.Delay(1000);
+                if (connection.ActiveChar != this)
+                    return; // logged out or changed character meanwhile
+                var target = Transform.ZoneId != 0 ? Transform.ZoneId : wantedZoneKey;
+                // old zone id 0: the previous host already released the unit on the first attempt
+                if (WorldIntegration.RelayCharacterZoneHandoff?.Invoke(ObjId, 0, target, WorldIntegration.BuildWzUnitStateBody(this)) == true)
+                {
+                    Logger.Info("Zone {0} is ready: {1} continues", target, Name);
+                    return;
+                }
+            }
+
+            Logger.Error("Zone {0} did not load in time for {1}; returning to character select", wantedZoneKey, Name);
+            EnterWorldManager.Instance.ReturnToCharacterSelect(connection, $"zone {wantedZoneKey} is not available");
+        }
+        catch (Exception ex)
+        {
+            Logger.Error(ex, "Waiting for zone {0} failed", wantedZoneKey);
+        }
+        finally
+        {
+            Interlocked.Exchange(ref _zoneHandoffWaiting, 0);
+        }
+    }
 
