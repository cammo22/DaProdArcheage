+    /// <summary>Token formato "{scadenzaUnix}.{hex(HMAC-SHA256(secret, utente|scadenza))}".</summary>
+    private static class DaProdToken
+    {
+        private static readonly string Secret = Environment.GetEnvironmentVariable("DAPROD_TOKEN_SECRET") ?? "";
+
+        public static bool IsValid(string? auth, string account)
+        {
+            if (Secret.Length == 0)
+                return true; // nessun segreto configurato: comportamento originale
+
+            try
+            {
+                using var doc = JsonDocument.Parse(auth ?? "");
+                if (!doc.RootElement.TryGetProperty("strUserToken", out var tk) || tk.GetString() is not { } token)
+                    return false;
+                var parts = token.Split('.');
+                if (parts.Length != 2 || !long.TryParse(parts[0], out var exp) || exp < DateTimeOffset.UtcNow.ToUnixTimeSeconds())
+                    return false;
+                using var h = new System.Security.Cryptography.HMACSHA256(System.Text.Encoding.UTF8.GetBytes(Secret));
+                var expected = Convert.ToHexString(h.ComputeHash(System.Text.Encoding.UTF8.GetBytes($"{account}|{exp}"))).ToLowerInvariant();
+                return System.Security.Cryptography.CryptographicOperations.FixedTimeEquals(
+                    System.Text.Encoding.ASCII.GetBytes(expected), System.Text.Encoding.ASCII.GetBytes(parts[1].ToLowerInvariant()));
+            }
+            catch
+            {
+                return false;
+            }
+        }
     }
 
