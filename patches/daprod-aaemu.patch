+
+/// <summary>
+/// DaProd: regole di gioco modificabili dal pannello in tempo reale. Il pannello scrive un file JSON
+/// (percorso in DAPROD_TWEAKS) con coppie nome:numero; il file viene riletto da solo quando cambia.
+/// Nome assente = valore di default (comportamento originale del gioco).
+/// </summary>
+public static class DaProdTweaks
+{
+    private static readonly string FilePath = Environment.GetEnvironmentVariable("DAPROD_TWEAKS");
+    private static readonly object Sync = new();
+    private static Dictionary<string, double> _values = [];
+    private static DateTime _stamp = DateTime.MinValue;
+    private static long _checkedAt;
+
+    private static Dictionary<string, double> Values
+    {
+        get
+        {
+            if (string.IsNullOrEmpty(FilePath))
+                return _values;
+            var now = Environment.TickCount64;
+            if (now - Interlocked.Read(ref _checkedAt) < 3000)
+                return _values;
+            lock (Sync)
+            {
+                Interlocked.Exchange(ref _checkedAt, now);
+                try
+                {
+                    var stamp = File.GetLastWriteTimeUtc(FilePath);
+                    if (stamp != _stamp)
+                    {
+                        var loaded = new Dictionary<string, double>(StringComparer.OrdinalIgnoreCase);
+                        using var doc = JsonDocument.Parse(File.ReadAllText(FilePath));
+                        foreach (var p in doc.RootElement.EnumerateObject())
+                        {
+                            if (p.Value.ValueKind == JsonValueKind.Number)
+                                loaded[p.Name] = p.Value.GetDouble();
+                            else if (p.Value.ValueKind == JsonValueKind.True)
+                                loaded[p.Name] = 1;
+                        }
+
+                        _values = loaded;
+                        _stamp = stamp;
+                    }
+                }
+                catch
+                {
+                    // file mancante o in scrittura: tengo i valori precedenti
+                }
+
+                return _values;
+            }
+        }
+    }
+
+    public static double Get(string name, double fallback) => Values.TryGetValue(name, out var v) ? v : fallback;
+
+    public static bool On(string name) => Values.TryGetValue(name, out var v) && v != 0;
+}
