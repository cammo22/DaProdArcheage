+using AAEmu.Commons.Utils.DB;
+using AAEmu.Game.Core.Packets.G2C;
+using AAEmu.Game.Models;
+using AAEmu.Game.Models.Game.Char;
+using AAEmu.Game.Models.Game.Items.Actions;
+using Microsoft.Data.Sqlite;
+using MySql.Data.MySqlClient;
+using NLog;
+
+namespace AAEmu.Game;
+
+/// <summary>
+/// DaProd: the daily schedule reward track (today_quest_goals / today_quest_goal_items). The client shows "complete N contracts, get
+/// item X"; the original server never gave those items. Completed contracts are counted per character and day, and every reward whose
+/// goal has been reached is handed out once (persisted in daprod_today_goal_rewards).
+/// </summary>
+public static class DaProdTodayGoals
+{
+    private static readonly Logger Logger = LogManager.GetCurrentClassLogger();
+
+    private sealed record Goal(uint Id, int Level);
+    private sealed record GoalItem(uint Id, uint GoalId, int Goal, uint ItemId, int Count);
+
+    private static List<Goal> _goals = [];
+    private static List<GoalItem> _items = [];
+    private static bool _tableReady;
+    private static readonly object Sync = new();
+
+    public static void Load(SqliteConnection connection)
+    {
+        var goals = new List<Goal>();
+        var items = new List<GoalItem>();
+        try
+        {
+            using (var c = connection.CreateCommand())
+            {
+                c.CommandText = "SELECT id, level FROM today_quest_goals";
+                using var r = c.ExecuteReader();
+                while (r.Read())
+                    goals.Add(new Goal((uint)r.GetInt64(0), (int)r.GetInt64(1)));
+            }
+
+            using (var c = connection.CreateCommand())
+            {
+                c.CommandText = "SELECT id, today_quest_goal_id, goal, item_id, item_num FROM today_quest_goal_items ORDER BY goal";
+                using var r = c.ExecuteReader();
+                while (r.Read())
+                    items.Add(new GoalItem((uint)r.GetInt64(0), (uint)r.GetInt64(1), (int)r.GetInt64(2), (uint)r.GetInt64(3), (int)r.GetInt64(4)));
+            }
+        }
+        catch (Exception ex)
+        {
+            Logger.Warn(ex, "DAPROD today goals not loaded");
+        }
+
+        _goals = goals;
+        _items = items;
+        Logger.Info("DAPROD today goals: {0} level brackets, {1} rewards", goals.Count, items.Count);
+    }
+
+    private static void EnsureTable(MySqlConnection c)
+    {
+        if (_tableReady)
+            return;
+        using var cmd = c.CreateCommand();
+        cmd.CommandText = "CREATE TABLE IF NOT EXISTS daprod_today_goal_rewards (owner INT UNSIGNED NOT NULL, day DATE NOT NULL, goal_item_id INT UNSIGNED NOT NULL, PRIMARY KEY (owner, day, goal_item_id))";
+        cmd.ExecuteNonQuery();
+        _tableReady = true;
+    }
+
+    /// <summary>Hands out every reward of the character's level bracket whose goal (completed contracts) has been reached today.</summary>
+    public static void TryGrant(Character character, int done)
+    {
+        if (character == null || done <= 0 || _items.Count == 0)
+            return;
+        try
+        {
+            // the bracket whose top level is the first at or above the character's level (levels 1-9 have their own row)
+            var bracket = _goals.Where(g => g.Level >= character.Level).OrderBy(g => g.Level).FirstOrDefault()
+                          ?? _goals.OrderByDescending(g => g.Level).FirstOrDefault();
+            if (bracket == null)
+                return;
+            var due = _items.Where(i => i.GoalId == bracket.Id && i.Goal <= done).ToList();
+            if (due.Count == 0)
+                return;
+
+            lock (Sync)
+            {
+                using var c = MySQL.CreateConnection();
+                EnsureTable(c);
+                var day = ServerCalendar.TodayUtc.Date;
+                var got = new HashSet<uint>();
+                using (var q = c.CreateCommand())
+                {
+                    q.CommandText = "SELECT goal_item_id FROM daprod_today_goal_rewards WHERE owner=@o AND day=@d";
+                    q.Parameters.AddWithValue("@o", character.Id);
+                    q.Parameters.AddWithValue("@d", day);
+                    using var r = q.ExecuteReader();
+                    while (r.Read())
+                        got.Add(r.GetUInt32(0));
+                }
+
+                foreach (var item in due.Where(i => !got.Contains(i.Id)))
+                {
+                    if (!character.Inventory.Bag.AcquireDefaultItem(ItemTaskType.QuestSupplyItems, item.ItemId, item.Count))
+                    {
+                        Logger.Info("DAPROD today goal {0}: bag full, reward {1} postponed for {2}", item.Goal, item.ItemId, character.Name);
+                        continue;
+                    }
+
+                    using var w = c.CreateCommand();
+                    w.CommandText = "INSERT IGNORE INTO daprod_today_goal_rewards (owner, day, goal_item_id) VALUES (@o, @d, @g)";
+                    w.Parameters.AddWithValue("@o", character.Id);
+                    w.Parameters.AddWithValue("@d", day);
+                    w.Parameters.AddWithValue("@g", item.Id);
+                    w.ExecuteNonQuery();
+                    character.SendPacket(new SCTodayAssignmentItemSentPacket(item.Id, false));
+                    Logger.Info("DAPROD today goal reward {0}: {1} x{2} (goal {3}, done {4})", character.Name, item.ItemId, item.Count, item.Goal, done);
+                }
+            }
+        }
+        catch (Exception ex)
+        {
+            Logger.Warn(ex, "DAPROD today goal reward failed for {0}", character.Name);
+        }
+    }
+}
